// The Windows executable's resources. build.py fills in the version.
// No headers: llvm-rc doesn't find the SDK's, so the few constants are
// numbers. 24 is RT_MANIFEST, 4 VOS_NT_WINDOWS32 and 1 VFT_APP.

1 ICON "tidalfast.ico"
1 24 "tidalfast.manifest"

1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "TIDALfast"
      VALUE "ProductName", "TIDALfast"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "OriginalFilename", "tidalfast.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
